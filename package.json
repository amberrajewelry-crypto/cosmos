{
  "name": "cosmos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "node scripts/gen-natal.mjs",
    "build:fn": "esbuild scripts/nebo-fn.ts --bundle --platform=node --format=esm --target=node20 --outfile=api/nebo.mjs --log-level=warning",
    "build": "tsc && node scripts/gen-natal.mjs && node scripts/gen-changelog.mjs && vite build && npm run build:fn",
    "preview": "vite preview",
    "test": "vitest run",
    "test:guard": "vitest run test-guard",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.185.4",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "geomagnetism": "^0.2.0",
    "luxon": "^3.7.2",
    "three": "^0.185.1"
  }
}
