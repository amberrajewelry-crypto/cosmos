{
  "rewrites": [
    {
      "source": "/bazi/",
      "destination": "/bazi.html"
    },
    {
      "source": "/bazi",
      "destination": "/bazi.html"
    },
    {
      "source": "/karta/",
      "destination": "/karta.html"
    },
    {
      "source": "/karta",
      "destination": "/karta.html"
    },
    {
      "source": "/nebo/:date(\\d{4}-\\d{2}-\\d{2})/",
      "destination": "/api/nebo?date=:date&lang=ru"
    },
    {
      "source": "/nebo/:date(\\d{4}-\\d{2}-\\d{2})",
      "destination": "/api/nebo?date=:date&lang=ru"
    },
    {
      "source": "/en/sky/:date(\\d{4}-\\d{2}-\\d{2})/",
      "destination": "/api/nebo?date=:date&lang=en"
    },
    {
      "source": "/en/sky/:date(\\d{4}-\\d{2}-\\d{2})",
      "destination": "/api/nebo?date=:date&lang=en"
    },
    {
      "source": "/sitemap-nebo.xml",
      "destination": "/api/nebo?sitemap=index"
    },
    {
      "source": "/sitemap-nebo-:year(\\d{4}).xml",
      "destination": "/api/nebo?sitemap=:year"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "georgia-tour.com"
        }
      ],
      "destination": "https://georgia-tour.com/bazi",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.georgia-tour.com"
        }
      ],
      "destination": "https://georgia-tour.com/bazi",
      "permanent": false
    },
    {
      "source": "/:znak(oven|telec|bliznecy|rak|lev|deva|vesy|skorpion|strelec|kozerog|vodolej|ryby)-na-samom-dele",
      "destination": "/natalnaya-karta/znak/:znak/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/bazi-sw.js",
      "headers": [
        {
          "key": "Service-Worker-Allowed",
          "value": "/bazi/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/bazi.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/places/:ver([0-9a-f]{8})/:file",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
